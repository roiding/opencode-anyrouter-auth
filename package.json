{
  "name": "opencode-anyrouter-auth",
  "version": "0.1.1",
  "description": "AnyRouter account login, session-based daily sign-in and native multi-account routing for Magpie, with conservative multi-protocol request protection.",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./server": "./index.mjs",
    "./generic": "./generic.mjs"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:host": "node --test test/host.integration.test.mjs",
    "test:gateway": "node --test test/gateway.integration.test.mjs"
  },
  "files": [
    "DESIGN.md",
    "LICENSE",
    "README.md",
    "UPSTREAM.md",
    "generic.mjs",
    "icon.png",
    "index.mjs",
    "lib/"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "magpie",
    "anyrouter",
    "checkin",
    "sign-in",
    "responses",
    "anthropic",
    "gemini"
  ],
  "license": "MIT",
  "magpie": {
    "icon": "data:image/png;base64,",
    "maxConcurrency": 4
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/roiding/opencode-anyrouter-auth.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
